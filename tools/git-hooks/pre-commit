#!/bin/sh
# 提交前检查与格式化.
#
# 绑定: 在仓库根目录执行下列指令，相应的取消操作定义于docs/README.md中。
# 	git config core.hooksPath tools/git-hooks
#
# 检查覆盖一直在维护的代码, 范围按语言划分:
#   Python  pyremu/ tests/ tools/        ruff check 与 ruff format
#   Rust    pyremu/_native/ bsp/sittim/  rustfmt
#   C{pp}       bsp/sittim/ bsp/kei-boot/ bsp/tee-tools/ bsp/eval-suites/
#               tests/src-alg/ tests/src-env/ tests/src-rv8/  clang-format
#
# 只处理本次已暂存的文件: 取 git diff --cached 给出的路径, 与上表的目录取交集,
# 再按扩展名分流. 未暂存的文件不被检查、不被改写, 也不加入索引.
# 全仓库检查另行执行 uv run ruff check . 等对应指令, 不在此处完成.
#
# 每个文件先做格式检查; 检查不通过时格式化该文件, 格式化仍失败则以 1 退出.
# 全部检查通过后, 把本次被格式化的文件加入索引, 提交继续进行.
#
# 语言与工具:
#   .py               uv run ruff format 与 uv run ruff check
#   .rs               rustfmt, 版本由文件所在 crate 的 Cargo.toml 给出, 找不到时取 2021
#   .c{c,pp}/.h{h,pp} clang-format -i, 配置由 clang-format 按文件所在目录向上查找
#                     本仓库的 .clang-format 需要 clang-format 20 及以上
#
# 缺失时提示并以 1 退出.

cd "$(git rev-parse --show-toplevel)" || exit 1

PY_CHECK_DIRS="pyremu tests tools"
RS_CHECK_DIRS="pyremu/_native bsp/sittim"
C_CHECK_DIRS="bsp/sittim bsp/kei-boot bsp/tee-tools bsp/eval-suites tests/src-alg tests/src-env tests/src-rv8"

PY_EXT_RE='\.py$'
RS_EXT_RE='\.rs$'
C_EXT_RE='\.(c|h|cc|cpp|hpp)$'

TAB=$(printf '\t')

require_tool() {
	if ! command -v "$1" >/dev/null 2>&1; then
		echo "pre-commit: $1 not found in PATH" >&2
		exit 1
	fi
}

# 由文件所在目录向上查找最近的 Cargo.toml, 取其 edition; 找不到时取 2021.
crate_edition() {
	dir=$(dirname "$1")
	while [ "$dir" != "." ] && [ "$dir" != "/" ]; do
		if [ -f "$dir/Cargo.toml" ]; then
			edition=$(sed -n 's/^edition[[:space:]]*=[[:space:]]*"\([0-9][0-9]*\)".*/\1/p' \
				"$dir/Cargo.toml" | head -n 1)
			if [ -n "$edition" ]; then
				echo "$edition"
				return 0
			fi
		fi
		dir=$(dirname "$dir")
	done
	echo 2021
}

# 从暂存路径中取出落在给定目录下、扩展名匹配且存在于工作区的文件.
# $1 为以空格分隔的目录列表, $2 为扩展名的正则.
staged_in() {
	prefix=$(printf '%s' "$1" | tr ' ' '|')
	printf '%s\n' "$STAGED" \
		| grep -E "^($prefix)/" \
		| grep -E "$2" \
		| while IFS= read -r f; do
			if [ -f "$f" ]; then
				printf '%s\n' "$f"
			fi
		done
}

STAGED=$(git -c core.quotePath=false diff --cached --name-only \
	--diff-filter=ACM)
if [ -z "$STAGED" ]; then
	exit 0
fi

WORK=$(mktemp -d) || exit 1
trap 'rm -rf "$WORK"' EXIT
FORMATTED="$WORK/formatted"
: > "$FORMATTED"

staged_in "$PY_CHECK_DIRS" "$PY_EXT_RE" > "$WORK/py_files"
staged_in "$RS_CHECK_DIRS" "$RS_EXT_RE" > "$WORK/rs_files"
staged_in "$C_CHECK_DIRS" "$C_EXT_RE" > "$WORK/c_files"

if [ -s "$WORK/py_files" ]; then
	require_tool uv
	echo "==> ruff check..."
	if ! xargs -r -d '\n' uv run ruff check < "$WORK/py_files"; then
		echo ""
		echo "ruff check failed. Fix errors above, then:"
		echo "  uv run ruff check --fix  $PY_CHECK_DIRS"
		exit 1
	fi
	echo "==> ruff format..."
	if ! xargs -r -d '\n' uv run ruff format --check \
		< "$WORK/py_files" >/dev/null 2>&1; then
		git hash-object --stdin-paths < "$WORK/py_files" \
			> "$WORK/py_before" || exit 1
		if ! xargs -r -d '\n' uv run ruff format < "$WORK/py_files"; then
			echo "ruff format failed." >&2
			exit 1
		fi
		git hash-object --stdin-paths < "$WORK/py_files" \
			> "$WORK/py_after" || exit 1
		paste -d "$TAB" "$WORK/py_files" "$WORK/py_before" "$WORK/py_after" \
			| awk -F "$TAB" '$2 != $3 { print $1 }' >> "$FORMATTED"
		if ! xargs -r -d '\n' uv run ruff format --check \
			< "$WORK/py_files" >/dev/null 2>&1; then
			echo "ruff format left files unformatted:" >&2
			xargs -r -d '\n' uv run ruff format --check \
				< "$WORK/py_files" >&2
			exit 1
		fi
	fi
fi

if [ -s "$WORK/rs_files" ]; then
	require_tool rustfmt
	echo "==> rustfmt..."
	while IFS= read -r f; do
		edition=$(crate_edition "$f")
		if rustfmt --check --config skip_children=true --edition "$edition" "$f" \
			>/dev/null 2>&1; then
			continue
		fi
		if ! rustfmt --config skip_children=true --edition "$edition" "$f"; then
			echo ""
			echo "rustfmt failed on $f (edition $edition)." >&2
			exit 1
		fi
		printf '%s\n' "$f" >> "$FORMATTED"
	done < "$WORK/rs_files"
fi

if [ -s "$WORK/c_files" ]; then
	require_tool clang-format
	echo "==> clang-format..."
	while IFS= read -r f; do
		if clang-format --dry-run --Werror "$f" >/dev/null 2>&1; then
			continue
		fi
		if ! clang-format -i "$f"; then
			echo ""
			echo "clang-format failed on $f."
			exit 1
		fi
		printf '%s\n' "$f" >> "$FORMATTED"
	done < "$WORK/c_files"
fi

if [ -s "$FORMATTED" ]; then
	echo "==> formatted files will be staged:"
	sed 's/^/    /' "$FORMATTED"
	while IFS= read -r f; do
		git add -- "$f"
	done < "$FORMATTED"
fi
echo "==> pre-commit OK"
